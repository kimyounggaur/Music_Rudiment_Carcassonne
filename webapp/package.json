{
  "name": "rhythm-village",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "vite build --mode artifact && node scripts/artifact.mjs",
    "build:web": "vite build --mode web",
    "build": "npm run build:artifact && npm run build:web",
    "preview": "vite preview",
    "icons": "vite-node scripts/icons.ts",
    "ai:match": "vite-node scripts/ai-match.ts --"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "2.1.8",
    "workbox-build": "7.3.0",
    "workbox-window": "7.3.0"
  }
}
